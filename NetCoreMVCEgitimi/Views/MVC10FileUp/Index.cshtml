
@{
    ViewBag.Title = "Mvc File Uploud - Dosya yukleme islemi";

}

<h2>@ViewBag.Title</h2>

<form action="" method="post" enctype="multipart/form-data">
    <input type="file" name="dosya" id="fileup" />
    <input type="submit" value="yukle" class="btn btn-success" />
</form>


<hr />

<img src="/Images/@TempData["resim"]" alt="resim yok" height="118" />

<div class="alert alert info">
    @TempData["Message"]
</div>

<p>
    dosya yuklmek ucun bir form elementine ihtiyac var 
    form elemnetine enctypr="multipart/form-data" attribute unu eklemek zorundayiz
    formada dasys yuklemek icin type'1 file olan elemnt gerekli
    file elementine verilen isim onemli post metodunda bu elementin name degerine gore eslesme saglaniyor 
</p>

@{
    var dosyalar = new DirectoryInfo(Directory.GetCurrentDirectory() + "/wwwroot/images/");
    var infoList = dosyalar.GetFiles();


}

<table class="table">
    <tr>
        <th>Resim</th>
        <th>Dosya</th>
        <th>Olusturma Tarihi</th>
        <th>Dosya Boyutu</th>
        <th>Sil</th>
    </tr>
    @foreach(var item in infoList)
    {
        <tr>
            <td>
                <img src="/Images/@item.Name" alt="@item.Name" height="58" />
            </td>
            <td>@item.Name</td>
            <td>@item.CreationTime</td>
            <td>@item.Length</td>
            <td>
                <form action="/MVC10FileUp/ResimSil" method="post">
                    <input type="hidden" name="resimYolu" value="@item.FullName" />
                    <button class="btn btn-danger" type="submit"> <span class="btn-close btn-close-white"></span></button>                 
           
                </form>

            </td>
        </tr>
    }
</table>
