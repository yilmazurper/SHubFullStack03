
@{
    ViewBag.Title = "MVC03 Data Transfer" ; 
}

<h2>MCV03 data Transfer</h2>

<h3>
    @ViewBag.UrunKategorisi Urunleri 
</h3>

<table class="table">
    <tr>
        <th>Urun Adi</th>
        <th>Fiyati</th>
        <th>Stok</th>
    </tr>
    @foreach (var item in ViewBag.Urunler)
    {
    <tr>
            <td>@item.Adi</td>
            <td>@item.Fiyati</td>
            <td>@item.Stok</td>
    </tr>
    }
    <caption>@TempData["UrunBilgi" ]</caption>
</table>

<hr />


<table class="table table-striped">
    <tr>
        <th>Urun Adi</th>
        <th>Fiyati</th>
        <th>Stok</th>
    </tr>
    @foreach (var item in ViewData["Urunler"] as List<Urun>)
    {
        <tr>
            <td>@item.Adi</td>
            <td>@item.Fiyati</td>
            <td>@item.Stok</td>
        </tr>
    }
    <caption>@TempData["UrunBilgi"]</caption>
</table>

<hr />

<h2>MVC de view dan controller a veri gonderme</h2>

<h3>
    1-get metoduyla veri gonderme
</h3>

<form action ="/MVC03DataTransfer/Search" method="get">
    <input type="text" name="txtAra" value="" placeholder="Ara" />

</form>

<p>
    bir formun metodunu get yapip calistirisak , form icindeki veriler Querystring denilne yondtemle tarayici cubugu uzerinden sunucuya gonderilir
    <hr />

    veriyi View'dan GET metoduyla gondermissek , contollerda da GET metoduyla yaklabiilriz 


</p>

<h3>

    2-post metoduyla veri gonderme

</h3>

@{
    var kategoriler = new List<SelectListItem>
    {
        new SelectListItem() { Text = "bilgisayar", Value = "1"},
        new SelectListItem() { Text = "monitor" },
        new SelectListItem() { Text = "telefon", Value = "3" },
        new SelectListItem() { Text = "TV", Value = "1" },
        new SelectListItem() { Text = "tablet", Value = "5" },
    };
}

<form action ="" method="post">

    <table class="table">
        <tr>
            <td>Urun Adi</td>
            <td>@Html.TextBox("txtUrunAdi")</td>
        </tr>
        <tr>
            <td>Kategori</td>
            <td>@Html.DropDownList("ddlKategori" , kategoriler)</td>
        </tr>
        <tr>
            <td>Sozlesme</td>
            <td>
                <label>
                    @Html.RadioButton("rbOnay" , "onay") kabul ediyorum 
                </label>
                <label>
                    @Html.RadioButton("rbOnay", "red") kabul etmiyorum
                </label>
            </td>
        </tr>
        <tr>
            <td>Durum</td>
            <td>@Html.CheckBox("cbOnay")<label for="cbOnay">Aktif</label></td>
            
        </tr>
        <tr>
            <td></td>
            <td><input type="submit" value="gonder"/></td>
        </tr>





    </table>

</form>

<hr />

