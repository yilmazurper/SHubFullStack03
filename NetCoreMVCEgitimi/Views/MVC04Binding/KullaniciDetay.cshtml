@model Kullanici
@{
    ViewBag.Title = "Kullanici Detay";
}
<h2>Kullanici Detay</h2>

<table class="table">
    <tr>
        <td>Ad</td>
        <td>@Model.Ad</td>
    </tr>
    <tr>
        <td>Soyad</td>
        <td>@Model.Soyad</td>
    </tr>
    <tr>
        <td>Email</td>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <td>Kullanici Adi</td>
        <td>@Model.KullaniciAdi</td>
    </tr>
    <tr>
        <td>Sifre</td>
        <td>@Model.Sifre</td>
    </tr>

</table>

<h3>
    model icerisinden gelen verileri duzenleme
</h3>
<form action="/MVC04Binding/KullaniciDetay" method="post">
    <table class="table">
        <tr>
            <td>Ad</td>
            <td>
                @Html.TextBoxFor(model => model.Ad)
            </td>
        </tr>
        <tr>
            <td>Soyad</td>
            <td>
                @Html.TextBoxFor(model => model.Soyad)
            </td>
        </tr>
        <tr>
            <td>Email</td>
            <td>@Html.TextBoxFor(model => model.Email)</td>
        </tr>
        <tr>
            <td>Kullanici Adi</td>
            <td>@Html.TextBoxFor(model => model.KullaniciAdi)</td>
        </tr>
        <tr>
            <td>Sifre</td>
            <td>@Html.EditorFor(model => model.Sifre)</td>
        </tr>

        <tr>
            <td></td>
            <td>
                <input type="submit" value="kaydet" class="btn btn-success" />
            </td>
        </tr>

    </table>

    


</form>


